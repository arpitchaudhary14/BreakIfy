# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/breakify

# JWT Secrets (generate 32+ char random strings in production)
JWT_ACCESS_SECRET=breakify-dev-access-secret-32-chars-long-minimum
JWT_REFRESH_SECRET=breakify-dev-refresh-secret-32-chars-long-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email (set EMAIL_SERVICE=smtp for production; console logs emails in dev)
EMAIL_SERVICE=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BreakIfy Security <security@breakify.site>
